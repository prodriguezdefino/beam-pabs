# Image of a Rust expansion service. One binary is both the expansion service
# and the SDK worker for the transforms that it expands.
#
# BASE_IMAGE is the Rust SDK image (Dockerfile), which holds only the `boot`
# launcher. The build context is the directory that holds the Linux binary,
# named `expansion_service`. `./gradlew :sdks:rust:expansionServiceImage`
# builds that binary and passes both in.
#
# - As a worker, the image keeps the base ENTRYPOINT, /opt/apache/beam/boot. A
#   runner starts it for the environment that the expansion service returns.
#   `boot` runs the binary at /opt/apache/beam/worker_binary with `--worker`.
# - As the expansion service, run the binary directly:
#     docker run -p 8097:8097 --entrypoint /opt/apache/beam/worker_binary \
#       <image> --port 8097 --docker-image <image>

ARG BASE_IMAGE

FROM ${BASE_IMAGE}
COPY expansion_service /opt/apache/beam/worker_binary
EXPOSE 8097
